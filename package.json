{
  "name": "electron-class-schedule-x",
  "version": "1.5.0",
  "description": "电子课表",
  "main": "src/main.js",
  "author": {
    "name": "Enigfrank",
    "email": "enigfrank@ecso.top"
  },
  "license": "GPLv3",
  "scripts": {
    "start": "chcp 65001 && electron .",
    "build": "electron-builder --win --x64 --publish never",
    "rebuild": "electron-rebuild"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.5",
    "@electron/rebuild": "^4.0.3",
    "electron": "^39.6.0",
    "electron-builder": "^26.7.0",
    "node-gyp": "^12.2.0"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "electron-disable-minimize": "^2.1.0",
    "electron-log": "^5.4.3",
    "electron-prompt": "^1.7.0",
    "electron-store": "^11.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "windows-shortcuts": "^0.1.6",
    "ws": "^8.19.0"
  },
  "build": {
    "asar": true,
    "asarUnpack": [],
    "appId": "com.enigfrank.ElectronClassScheduleX",
    "productName": "电子课表",
    "compression": "maximum",
    "copyright": "Copyright © Enigfrank",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "src/image/icon.ico",
      "signingHashAlgorithms": ["sha256"],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE.rtf",
      "runAfterFinish": false,
      "shortcutName": "电子课表"
    },
    "files": [
      "src/**/*"
    ],
    "directories": {
      "output": "out"
    }
  }
}