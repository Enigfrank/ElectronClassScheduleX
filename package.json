{
  "name": "electron-class-schedule-x",
  "version": "1.6.0",
  "description": "电子课表",
  "main": "src/main.js",
  "author": {
    "name": "Enigfrank",
    "email": "enigfrank@ecso.top"
  },
  "license": "GPL-3.0",
  "scripts": {
    "start": "chcp 65001 && electron .",
    "test": "node --test tests/*.test.js",
    "build": "chcp 65001 && electron-builder --win --x64 --publish never",
    "rebuild": "electron-rebuild"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "26.8.1"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-prompt": "^1.7.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.7.2",
    "json5": "^2.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "build": {
    "asar": true,
    "asarUnpack": [],
    "appId": "com.enigfrank.ElectronClassScheduleX",
    "productName": "电子课表",
    "artifactName": "Setup.${version}.${ext}",
    "compression": "maximum",
    "copyright": "Copyright © Enigfrank",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/image/icon.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "shortcutName": "电子课表"
    },
    "files": [
      "src/**/*"
    ],
    "directories": {
      "output": "out"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Enigfrank",
        "repo": "ElectronClassScheduleX"
      }
    ]
  },
  "packageManager": "yarn@4.14.1"
}
